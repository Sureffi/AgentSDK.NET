root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,jsonl,md,yml,yaml,props,targets,csproj,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0130.severity = warning

[Claude.Agent/DependencyInjection/ClaudeAgentServiceCollectionExtensions.cs]
dotnet_diagnostic.IDE0130.severity = none
