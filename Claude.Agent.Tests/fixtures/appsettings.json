{
  "ClaudeAgent": {
    "ExecutablePath": "/usr/local/bin/claude",
    "EnvironmentVariables": {
      "MINT_MODE": "fixture"
    },
    "ProcessGracePeriod": "00:00:03",
    "MaxMessageSize": 2097152,
    "ConfigurationDirectory": "/tmp/mint/claude-agent",
    "Defaults": {
      "WorkingDirectory": "/tmp/mint",
      "SystemPrompt": {
        "Preset": true,
        "Append": "Answer in one short paragraph.",
        "ExcludeDynamicSections": true
      },
      "Model": "sonnet",
      "FallbackModel": "haiku",
      "Effort": "high",
      "Thinking": {
        "Mode": "budget",
        "BudgetTokens": 4096
      },
      "Betas": [
        "context-1m-2025-08-07"
      ],
      "MaxTurns": 8,
      "MaxBudgetUsd": 12.5,
      "TaskBudget": 3,
      "Tools": [
        "Read",
        "Write"
      ],
      "AllowedTools": [
        "Read",
        "mcp__calc__add"
      ],
      "DisallowedTools": [
        "Bash"
      ],
      "PermissionMode": "acceptEdits",
      "PermissionPromptTool": "mcp__calc__ask",
      "McpServers": {
        "hive": {
          "Type": "stdio",
          "Command": "hive-server",
          "Args": [
            "--stdio"
          ],
          "Env": {
            "HIVE_TOKEN": "token"
          },
          "Timeout": 30000,
          "AlwaysLoad": true
        },
        "feed": {
          "Type": "sse",
          "Url": "https://mint.example/sse",
          "Headers": {
            "Authorization": "Bearer token"
          },
          "Tools": [
            {
              "Name": "watch",
              "PermissionPolicy": "always_ask"
            }
          ],
          "Timeout": 15000,
          "AlwaysLoad": false
        },
        "web": {
          "Type": "http",
          "Url": "https://mint.example/mcp",
          "Headers": {
            "Authorization": "Bearer token"
          },
          "Tools": [
            {
              "Name": "search",
              "PermissionPolicy": "always_allow",
              "OrganizationMaxPermission": "ask"
            }
          ]
        }
      },
      "OnlyConfiguredMcpServers": true,
      "Agents": {
        "bee": {
          "Description": "reads the hive",
          "Prompt": "You are a bee.",
          "Tools": [
            "Read"
          ],
          "DisallowedTools": [
            "Bash"
          ],
          "Model": "haiku",
          "Skills": [
            "blueprint"
          ],
          "Memory": "/tmp/mint/bee.md",
          "McpServers": [
            "hive"
          ],
          "InitialPrompt": "buzz",
          "MaxTurns": 2,
          "Background": true,
          "Effort": "low",
          "PermissionMode": "plan"
        }
      },
      "Skills": [
        "blueprint"
      ],
      "PluginDirectories": [
        "/tmp/mint/plugins/hive"
      ],
      "Settings": "/tmp/mint/settings.json",
      "SettingSources": [
        "project",
        "local"
      ],
      "Sandbox": {
        "Enabled": true,
        "AutoAllowBashIfSandboxed": true,
        "ExcludedCommands": [
          "git push"
        ],
        "AllowUnsandboxedCommands": false,
        "EnableWeakerNestedSandbox": true,
        "AllowedDomains": [
          "api.anthropic.com"
        ],
        "DeniedDomains": [
          "telemetry.example"
        ],
        "AllowManagedDomainsOnly": false,
        "AllowUnixSockets": [
          "/run/mint.sock"
        ],
        "AllowAllUnixSockets": false,
        "AllowLocalBinding": true,
        "AllowMachLookup": [
          "com.apple.dnssd"
        ],
        "HttpProxyPort": 8080,
        "SocksProxyPort": 1080,
        "IgnoredFileViolations": [
          "/tmp/mint/cache"
        ],
        "IgnoredNetworkViolations": [
          "logs.example"
        ]
      },
      "AdditionalDirectories": [
        "/tmp/mint/docs"
      ],
      "IncludePartialMessages": true,
      "IncludeHookEvents": true,
      "ForwardSubagentText": true,
      "ReplayUserMessages": true,
      "OutputSchema": "{\"type\":\"object\",\"properties\":{\"answer\":{\"type\":\"string\"}},\"required\":[\"answer\"]}",
      "EnableFileCheckpointing": true
    }
  },
  "ClaudeAgentAlternate": {
    "Defaults": {
      "SystemPrompt": {
        "Text": "You are Mint."
      },
      "AllSkills": true,
      "Thinking": {
        "Mode": "adaptive",
        "OmitThinking": true
      }
    }
  },
  "ClaudeAgentEmpty": {}
}
